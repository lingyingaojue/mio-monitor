<?xml version="1.0" encoding="utf-8"?>
<!-- 启动窗背景（浅色）：与 Compose 页面底一致，冷启动不闪深色窗；
     真正的品牌渐变在 Compose 开屏层绘制（随配色预设变化）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F3F6F9"
        android:endColor="#FFFFFF"
        android:type="linear" />
</shape>
